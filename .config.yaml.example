# SPanel-Go 用户隐私覆盖配置模板
# 复制为 .config.yaml (已加入 .gitignore) 并填入真实值,
# 此处的键会深度覆盖 config.yaml 中的同名键, 只需写需要覆盖的部分。

app:
  key: ""                         # 系统安全密钥 (随机字符串)
  muKey: ""                       # 面板与节点通信校验主密钥

database:
  username: ""
  password: ""

redis:
  password: ""

jwt:
  secret: ""                      # JWT 签名密钥 (随机字符串)

# 其他敏感段 (按需取消注释):
# smtp:
#   username: ""
#   password: ""
# telegram:
#   token: ""
#   admin_token: ""
# cloudflare:
#   api_token: ""
# payment:
#   clonepay_apis:
#     game:
#       paytoken: "xxx"
